# Used only by the local dev server and the Vercel function. Never prefix with VITE_.
# Leave LLM_API_KEY empty to run rules-only on the phone.

LLM_API_KEY=
# openai | openai-compatible | anthropic
LLM_PROVIDER=openai
# For OpenRouter or a proxy, set the base URL and LLM_PROVIDER=openai-compatible.
# Example: https://openrouter.ai/api/v1
LLM_BASE_URL=
# Defaults: gpt-4o-mini (openai), or the model your proxy expects.
# gpt-4o-mini remains on the OpenAI API until 14 Jan 2027; gpt-6-luna is the newer replacement.
LLM_MODEL=
