{
  "name": "framing-cam",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source portrait camera for the mobile browser. A friend holds the phone; the page coaches them into a stronger frame, then crops.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "vite --host",
    "dev:https": "HTTPS=1 vite --host",
    "dev:mkcert": "HTTPS_KEY=certs/dev-key.pem HTTPS_CERT=certs/dev-cert.pem vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "preview:https": "HTTPS=1 vite preview --host",
    "test": "vitest run",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
